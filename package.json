{
  "name": "checkin-assistant",
  "version": "1.0.9",
  "private": true,
  "description": "签到助手：AnyRouter、AgentRouter 与兼容站点的网页签到和额度控制台",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist-server/main.js",
    "dev": "tsx server/main.ts",
    "test": "tsx --test --test-concurrency=2 tests-node/*.test.ts",
    "test:ui": "node tests-node/ui-smoke.mjs",
    "test:ui:accounts": "node tests-node/account-transfer-ui-smoke.mjs",
    "test:docker": "node tests-node/docker-smoke.mjs",
    "package:web": "node scripts/package-web.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "got": "^14.6.5",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "playwright-core": "^1.56.1",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/yazl": "^3.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yazl": "^3.3.1"
  }
}
