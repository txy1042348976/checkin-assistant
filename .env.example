# Copy to .env before deploying. Use the actual external root URL, without a path.
CHECKIN_PUBLIC_URL=https://checkin.example.com

# Leave both empty to set your administrator account on the first web visit.
# The form asks for username, password and password confirmation, then signs you in.
CHECKIN_ADMIN_USER=
CHECKIN_ADMIN_PASSWORD=
# Optional preset: only initializes a database without an administrator.
# Username: 2-40 letters, digits, dots, underscores or hyphens; an omitted preset uses admin.
# Password: 12-1024 characters with at least two of letters, digits and symbols.
# Existing saved credentials always win. Later password changes use the web settings.

# Host port for Docker Compose; default is local-only for a reverse proxy.
CHECKIN_BIND_IP=127.0.0.1
CHECKIN_PORT=8765

# Timezone and server task limits.
CHECKIN_TIMEZONE=Asia/Shanghai
CHECKIN_MAX_CONCURRENT_RUNS=1

# Starting profile for a 1-core / 1 GiB host with a few accounts.
# Configure at least 2 GiB total swap on the HOST before deploying.
# Low-memory mode limits browser use and releases it after each task.
CHECKIN_LOW_MEMORY=1
CHECKIN_MEMORY_LIMIT=640m
# Total container RAM + swap allowance, not an additional swap allocation.
CHECKIN_MEMORY_SWAP_LIMIT=1280m
# These values reduce peak pressure; sustained swapping still slows tasks.
# For a larger host, set CHECKIN_LOW_MEMORY=0, CHECKIN_MEMORY_LIMIT=2g,
# and CHECKIN_MEMORY_SWAP_LIMIT=0 to use the general Compose defaults.
# A swap limit of 0 uses Docker's default.

# Optional AgentRouter default server proxy; per-account settings take precedence.
# Manual credential saves only write the app database. Tasks use the server network;
# original-site login uses your own browser.
# In Docker, 127.0.0.1 refers to the container. Use host.docker.internal for a host proxy.
CHECKIN_PROXY_URL=

# Direct Node.js development may additionally set CHECKIN_HOST, CHECKIN_DATA_DIR,
# CHECKIN_BROWSER_PATH and CHECKIN_SESSION_HOURS. Compose supplies its own data path
# and bundled Chromium path. Use an http://localhost:PORT root URL for local access.
